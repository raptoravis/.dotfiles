theme = {{theme_ghostty}}

# Font
font-family = FiraCode Nerd Font
font-size = 14

# Window
window-decoration = true
background-opacity = 1
background-blur = 20
window-padding-x = 0
window-padding-y = 0
confirm-close-surface = false
macos-titlebar-style = tabs

# Cursor
cursor-style = bar
cursor-style-blink = false

# Scrollback
scrollback-limit = 10000

# Global keybinding to summon a quick terminal
# https://ghostty.org/docs/config/reference#quick-terminal-size
quick-terminal-screen = main
quick-terminal-size = 1000px,700px
quick-terminal-animation-duration = .02
quick-terminal-position = center
quick-terminal-space-behavior = remain

# Keybinds
keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = shift+enter=text:\x1b\r
keybind = cmd+shift+c=text:clip_last_output\n
